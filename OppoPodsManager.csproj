<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CurryPods</AssemblyName>
    <Product>CurryPods</Product>
    <Title>CurryPods</Title>
    <Version>2.0.0</Version>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OppoPodsManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\VisualAssets\tuopan.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <NoWarn>CA1416;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <!-- Single-project MSIX Packaging Capability -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!-- Windows Bluetooth only, remove Linux communication files -->
  <ItemGroup>
    <Compile Remove="Communication\Transport\Linux\**\*.cs" />
    <Compile Remove="Communication\Linux\**\*.cs" />
  </ItemGroup>

  <!-- Windows App SDK & Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Assets and Resources -->
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**\*" Exclude="Assets\**\*.cs;Assets\Localization\Strings*.json;Assets\*\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Assets\Oplus\Data\DeviceModels.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.DeviceModels.json" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.json" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.en.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.en.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.de.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.de.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.ru.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.ru.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Vivo\Data\DeviceModels.json" LogicalName="OppoPodsManager.Assets.Vivo.Data.DeviceModels.json" />
    <EmbeddedResource Include="Assets\Localization\Strings.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.json" />
    <EmbeddedResource Include="Assets\Localization\Strings.en.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Localization\Strings.de.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.de.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Localization\Strings.ru.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.ru.json" WithCulture="false" />
  </ItemGroup>
</Project>
