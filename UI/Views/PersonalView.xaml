<UserControl
    x:Class="OppoPodsManager.UI.Views.PersonalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">

  <StackPanel Spacing="12" HorizontalAlignment="Stretch" Margin="0,0,0,8">

    <!-- 外观 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Personal_Appearance}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{l10n:Translate Key=Personal_Language}" FontSize="13" VerticalAlignment="Center"/>
          <ComboBox x:Name="CbLanguage" Height="32" Width="180" DisplayMemberPath="DisplayName" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{l10n:Translate Key=Personal_Theme}" FontSize="13" VerticalAlignment="Center"/>
          <ComboBox x:Name="CbTheme" Height="32" Width="140" HorizontalAlignment="Left">
            <ComboBoxItem Content="{l10n:Translate Key=Personal_ThemeFollowSystem}"/>
            <ComboBoxItem Content="{l10n:Translate Key=Personal_ThemeDark}"/>
            <ComboBoxItem Content="{l10n:Translate Key=Personal_ThemeLight}"/>
          </ComboBox>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- 弹窗设置 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Personal_ToastSettings}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48">
            <TextBlock Text="{l10n:Translate Key=Personal_LowBatteryToast}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="CbLowBatteryToast" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                          AutomationProperties.Name="{l10n:Translate Key=Personal_LowBatteryToast}" VerticalAlignment="Center"/>
          </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48">
            <TextBlock Text="{l10n:Translate Key=Personal_ConnectionToast}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="CbConnectionToast" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                          AutomationProperties.Name="{l10n:Translate Key=Personal_ConnectionToast}" VerticalAlignment="Center"/>
          </Grid>
        <Button x:Name="BtnPreviewToast" Content="{l10n:Translate Key=Personal_PreviewToast}" Click="PreviewToast_Click"/>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{l10n:Translate Key=Personal_ToastDuration}" FontSize="13" VerticalAlignment="Center"/>
          <ComboBox x:Name="CbToastDuration" Height="32" Width="140" HorizontalAlignment="Left">
            <ComboBoxItem Content="3s"/>
            <ComboBoxItem Content="4s"/>
            <ComboBoxItem Content="{l10n:Translate Key=Personal_ToastDurationDefault}"/>
            <ComboBoxItem Content="6s"/>
            <ComboBoxItem Content="7s"/>
            <ComboBoxItem Content="8s"/>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 自定义耳机图案 -->
    <Border Style="{StaticResource PageCardStyle}" HorizontalAlignment="Stretch">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Personal_CustomEarphone}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <VariableSizedWrapGrid x:Name="EarphoneCustomContent" x:FieldModifier="public" Orientation="Horizontal" ItemWidth="136" ItemHeight="100"/>
      </StackPanel>
    </Border>

    <!-- 设备 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Personal_Device}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock Text="{l10n:Translate Key=Personal_CustomDeviceName}" FontSize="13" Opacity="0.6"/>
        <TextBox x:Name="TbCustomName" Height="32" Padding="8,4" HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Border>


    <Border Height="24" Background="Transparent"/>
  </StackPanel>
</UserControl>
