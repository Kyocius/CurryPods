<UserControl
    x:Class="OppoPodsManager.UI.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">
  <StackPanel Spacing="14" Margin="0,0,0,40">
    <Border Padding="22,20" CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel>
        <TextBlock Text="CurryPods" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock x:Name="VersionText" FontSize="15" HorizontalAlignment="Center"
                   Opacity="0.65" Margin="0,0,0,6"/>
        <HyperlinkButton Content="GitHub" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,18"
                         Click="OpenUrl_Click" Tag="https://github.com/Zhaoyi-ya/OppoPodsManager"/>

        <TextBlock Text="{l10n:Translate Key=About_Acknowledgments}" FontSize="17" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Text="{l10n:Translate Key=About_ProtocolReverseEngineering}" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.7"/>

        <HyperlinkButton Content="Leaf-lsgtky/OppoPods" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/Leaf-lsgtky/OppoPods"/>
        <HyperlinkButton Content="1812z/OppoPods" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/1812z/OppoPods"/>
        <HyperlinkButton Content="Nshpiter/HuaweiPods" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/Nshpiter/HuaweiPods"/>
        <HyperlinkButton Content="wh201906/mEDIFIER" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/wh201906/mEDIFIER"/>
        <HyperlinkButton Content="silverpoetry/HyperEars" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/silverpoetry/HyperEars"/>
        <HyperlinkButton Content="Star-ZER0/Pods-Protocol-Reverse-Engineering" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/Star-ZER0/Pods-Protocol-Reverse-Engineering"/>
        <HyperlinkButton Content="melianmiko/OpenFreebuds" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/melianmiko/OpenFreebuds"/>
        <HyperlinkButton Content="CesurPolat/MiBudsClient" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/CesurPolat/MiBudsClient"/>
        <HyperlinkButton Content="web1n/android_packages_apps_XiaomiTWS" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/web1n/android_packages_apps_XiaomiTWS"/>
        <HyperlinkButton Content="web1n/android_packages_apps_XiaomiTWS_xiaomi-sdk" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/web1n/android_packages_apps_XiaomiTWS_xiaomi-sdk"/>
        <HyperlinkButton Content="librepods-org/librepods" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/librepods-org/librepods"/>

        <TextBlock Text="{l10n:Translate Key=About_OpenSourceLibraries}" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,12,0,4" Opacity="0.7"/>
        <HyperlinkButton Content="Windows App SDK (WinUI 3)" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/microsoft/microsoft-ui-xaml"/>
        <HyperlinkButton Content="H.NotifyIcon" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"
                         Click="OpenUrl_Click" Tag="https://github.com/HavenDV/H.NotifyIcon"/>

        <TextBlock Text="{l10n:Translate Key=About_FontNotice}"
                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.5"
                   Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
