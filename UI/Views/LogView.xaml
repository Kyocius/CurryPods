<UserControl
    x:Class="OppoPodsManager.UI.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">
  <Border Margin="16,12,16,16" Padding="14,12" CornerRadius="14"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
      <!-- 顶栏 -->
      <CommandBar Grid.Row="0" Margin="0,0,0,12" DefaultLabelPosition="Right" Background="Transparent">
        <AppBarButton x:Name="BtnLogExport" Label="{l10n:Translate Key=Log_ExportZip}"
                      Icon="Save" Click="BtnLogExport_Click"/>
      </CommandBar>

      <!-- 日志列表 -->
      <ListView Grid.Row="1" x:Name="LbLog" BorderThickness="0" Background="Transparent"
                SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas, Cascadia Mono, monospace"
                       TextWrapping="NoWrap" Margin="0,2"/>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Border>
</UserControl>
