<UserControl
    x:Class="OppoPodsManager.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OppoPodsManager.UI.Controls"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">
  <StackPanel Spacing="14" Margin="0,0,0,40">
    <!-- 页面标题 -->
    <TextBlock Text="{l10n:Translate Key=Settings_Title}" FontSize="16" FontWeight="SemiBold"
               HorizontalAlignment="Center"/>

    <!-- 本机设备 -->
    <Border Padding="18,16" CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_ThisDevice}" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_DeviceName}" FontSize="13"
                     Opacity="0.6" Margin="0,0,20,6"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiDeviceName" Text="-" FontSize="13"
                     Margin="0,0,0,6"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_FirmwareVersion}" FontSize="13"
                     Opacity="0.6" Margin="0,0,20,6"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiFirmware" Text="-" FontSize="13"
                     Margin="0,0,0,6"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_Codec}" FontSize="13"
                     Opacity="0.6"/>
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiCodec" Text="-" FontSize="13"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 应用 -->
    <Border Padding="18,16" CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_App}" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
        <StackPanel Spacing="6">
          <CheckBox x:Name="CbAuto" Content="{l10n:Translate Key=Settings_AutoStart}"/>
          <CheckBox x:Name="CbTray" Content="{l10n:Translate Key=Settings_CloseToTray}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 工具 -->
    <Border Padding="18,16" CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_Tools}" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
        <controls:WrapPanel Orientation="Horizontal">
          <Button x:Name="BtnCheckUpdate" Content="{l10n:Translate Key=Settings_GetUpdate}"
                  Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,8"
                  Click="BtnCheckUpdate_Click"/>
          <Button x:Name="BtnFeedback" Content="{l10n:Translate Key=Settings_Feedback}"
                  Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,8"
                  Click="BtnFeedback_Click"/>
          <Button x:Name="BtnViewLog" Content="{l10n:Translate Key=Settings_ViewLog}"
                  Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,8"
                  Click="BtnViewLog_Click"/>
          <Button x:Name="BtnRestoreHiddenDevices" Content="{l10n:Translate Key=Settings_RestoreHiddenDevices}"
                  Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,8"
                  Click="BtnRestoreHiddenDevices_Click"/>
          <Button Content="{l10n:Translate Key=Settings_About}"
                  Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,8"
                  Click="About_Click"/>
        </controls:WrapPanel>
      </StackPanel>
    </Border>

    <!-- 连接策略 -->
    <Border x:Name="DiConnectionStrategyCard" Padding="18,16" Visibility="Collapsed"
            CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Sidebar_ConnectionStrategy}" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>
        <StackPanel x:Name="PriorityDevicePanel" Visibility="Collapsed" Spacing="6" Margin="0" HorizontalAlignment="Stretch">
          <TextBlock Text="{l10n:Translate Key=Sidebar_PriorityDevice}" FontSize="12" Opacity="0.6"
                     Margin="0" HorizontalAlignment="Left"/>
          <ComboBox x:Name="CbPriorityDevice" Height="32" Padding="8,0"
                    Margin="0" HorizontalAlignment="Stretch" PlaceholderText="{l10n:Translate Key=Sidebar_AutoSelect}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
