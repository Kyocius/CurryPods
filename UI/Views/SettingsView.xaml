<UserControl
    x:Class="OppoPodsManager.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">
  <StackPanel Spacing="12" Margin="0,0,0,8">
    <!-- 页面标题 -->

    <!-- 本机设备 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_ThisDevice}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_DeviceName}" FontSize="13"
                     Opacity="0.6" Margin="0,0,20,6"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiDeviceName" Text="-" FontSize="13"
                     Margin="0,0,0,6"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_FirmwareVersion}" FontSize="13"
                     Opacity="0.6" Margin="0,0,20,6"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiFirmware" Text="-" FontSize="13"
                     Margin="0,0,0,6"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:Translate Key=DeviceInfo_Codec}" FontSize="13"
                     Opacity="0.6"/>
          <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiCodec" Text="-" FontSize="13"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 应用 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_App}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48">
            <TextBlock Text="{l10n:Translate Key=Settings_AutoStart}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="CbAuto" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                          AutomationProperties.Name="{l10n:Translate Key=Settings_AutoStart}" VerticalAlignment="Center"/>
          </Grid>
          <InfoBar x:Name="StartupInfo" IsOpen="False" IsClosable="False" Severity="Warning">
            <InfoBar.ActionButton>
              <Button Content="{l10n:Translate Key=Settings_OpenStartupSettings}" Click="OpenStartupSettings_Click"/>
            </InfoBar.ActionButton>
          </InfoBar>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48">
            <TextBlock Text="{l10n:Translate Key=Settings_CloseToTray}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="CbTray" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                          AutomationProperties.Name="{l10n:Translate Key=Settings_CloseToTray}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 工具 -->
    <Border Style="{StaticResource PageCardStyle}">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Settings_Tools}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
          <AppBarButton x:Name="BtnCheckUpdate" Label="{l10n:Translate Key=Settings_GetUpdate}" Icon="Download"
                  Click="BtnCheckUpdate_Click"/>
          <AppBarButton x:Name="BtnFeedback" Label="{l10n:Translate Key=Settings_Feedback}" Icon="Message"
                  Click="BtnFeedback_Click"/>
          <AppBarButton x:Name="BtnViewLog" Label="{l10n:Translate Key=Settings_ViewLog}" Icon="Document"
                  Click="BtnViewLog_Click"/>
          <AppBarButton x:Name="BtnRestoreHiddenDevices" Label="{l10n:Translate Key=Settings_RestoreHiddenDevices}" Icon="Refresh"
                  Click="BtnRestoreHiddenDevices_Click"/>
          <AppBarButton Label="{l10n:Translate Key=Settings_About}" Icon="Help"
                  Click="About_Click"/>
        </CommandBar>
      </StackPanel>
    </Border>

    <!-- 连接策略 -->
    <Border Style="{StaticResource PageCardStyle}" x:Name="DiConnectionStrategyCard" Visibility="Collapsed">
      <StackPanel Spacing="10">
        <TextBlock Text="{l10n:Translate Key=Sidebar_ConnectionStrategy}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel x:Name="PriorityDevicePanel" Visibility="Collapsed" Spacing="6" Margin="0" HorizontalAlignment="Stretch">
          <TextBlock Text="{l10n:Translate Key=Sidebar_PriorityDevice}" FontSize="12" Opacity="0.6"
                     Margin="0" HorizontalAlignment="Left"/>
          <ComboBox x:Name="CbPriorityDevice" Height="32" Padding="8,0"
                    Margin="0" HorizontalAlignment="Stretch" PlaceholderText="{l10n:Translate Key=Sidebar_AutoSelect}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
