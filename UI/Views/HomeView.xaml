<UserControl
    x:Class="OppoPodsManager.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">

  <StackPanel Spacing="14" Margin="0,0,0,40">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="WideControls">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="1000"/>
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="NarrowControls">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0"/>
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="AncPanel.(Grid.ColumnSpan)" Value="2"/>
              <Setter Target="FeatureCard.(Grid.Column)" Value="0"/>
              <Setter Target="FeatureCard.(Grid.Row)" Value="1"/>
              <Setter Target="FeatureCard.(Grid.ColumnSpan)" Value="2"/>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    <Border Padding="16,14" CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="6">
        <!-- 状态与设备切换行 -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="28" Margin="0,0,10,0">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,8,0">
            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8" Fill="#FF5555" Margin="0,0,6,0"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="{l10n:Translate Key=Status_Disconnected}" FontSize="14" Foreground="#FF8888"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ComboBox x:Name="CbDevice" Grid.Column="1" Height="30" FontSize="11" MinWidth="96" MaxWidth="280"
                    HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed"
                    DisplayMemberPath="DisplayName"
                    ToolTipService.ToolTip="{l10n:Translate Key=Status_SwitchDeviceTooltip}"/>
          <Button x:Name="BtnRefreshDevices" Grid.Column="2" Content="&#x27F3;" Height="30" Width="30" FontSize="13"
                  Click="RefreshDevices_Click" Padding="0" Visibility="Collapsed" Margin="0,0,8,0"
                  ToolTipService.ToolTip="{l10n:Translate Key=Status_RefreshDevicesTooltip}"/>
          <Button x:Name="BtnReconnect" Grid.Column="3" Content="{l10n:Translate Key=Status_Reconnect}" Height="30" FontSize="13"
                  Click="Reconnect_Click" Padding="10,0" Visibility="Collapsed"/>
        </Grid>

        <!-- 电量槽位 -->
        <Grid x:Name="BatteryGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10" MinHeight="150">
          <StackPanel x:Name="LeftBatteryPanel" Grid.Column="0" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="LeftBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="LeftBatteryTitle" Text="{l10n:Translate Key=Battery_Left}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="LeftLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="LeftChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="LeftBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel x:Name="RightBatteryPanel" Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="RightBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="RightBatteryTitle" Text="{l10n:Translate Key=Battery_Right}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="RightLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="RightChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="RightBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel x:Name="CaseBatteryPanel" Grid.Column="2" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="CaseBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="CaseBatteryTitle" Text="{l10n:Translate Key=Battery_Case}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="CaseLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="CaseChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="CaseBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="WearStatus" Text="" FontSize="12" HorizontalAlignment="Center"
                   Opacity="0.5" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <!-- ANC + 功能 并排 -->
    <Grid x:Name="DeviceControlsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

      <Border x:Name="AncPanel" Padding="12,14" Grid.Column="0"
              CornerRadius="14"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel Spacing="8">
          <TextBlock Text="{l10n:Translate Key=Anc_Title}" FontSize="14"
                     HorizontalAlignment="Center"/>
          <TextBlock x:Name="AncPlaceholderText" Text="{l10n:Translate Key=Anc_Placeholder}" FontSize="13"
                     HorizontalAlignment="Center" Opacity="0.45"/>
          <Grid x:Name="AncMainRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
          <Grid x:Name="AncSubRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
          <TextBlock x:Name="AncRealtimeHint" FontSize="12" Opacity="0.5" Visibility="Collapsed"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>

      <Border x:Name="FeatureCard" Padding="12,14" Grid.Column="1"
              CornerRadius="14"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{l10n:Translate Key=Feature_Title}" FontSize="14" Margin="0,0,0,6"
                     HorizontalAlignment="Center"/>
          <TextBlock x:Name="FeaturePlaceholderText" Text="{l10n:Translate Key=Feature_Placeholder}" FontSize="13"
                     HorizontalAlignment="Center" Opacity="0.45"/>
          <StackPanel x:Name="FeatureContentPanel" Visibility="Collapsed">
            <StackPanel Spacing="4" HorizontalAlignment="Stretch" Margin="0,0,0,6">
              <CheckBox x:Name="CbDualDevice" Content="{l10n:Translate Key=Feature_DualDevice}" Margin="0,3"/>
              <CheckBox x:Name="CbGame" Content="{l10n:Translate Key=Feature_GameMode}" Margin="0,3"/>
              <CheckBox x:Name="CbLongPower" Content="{l10n:Translate Key=Feature_LongPowerMode}" Margin="0,3"/>
              <CheckBox x:Name="CbWearDetection" Content="{l10n:Translate Key=Feature_WearDetection}" Margin="0,3"/>
              <CheckBox x:Name="CbSpineHealth" Content="{l10n:Translate Key=Feature_SpineHealth}" Margin="0,3"/>
              <CheckBox x:Name="CbSpatial" Content="{l10n:Translate Key=Feature_SpatialSound}" Margin="0,3"/>
              <CheckBox x:Name="CbGameSound" Content="{l10n:Translate Key=Feature_GameSound}" Margin="0,3"/>
              <CheckBox x:Name="CbBassEngine" Content="{l10n:Translate Key=Feature_BassEngine}" Margin="0,3"/>
              <CheckBox x:Name="CbVocalEnhance" Content="{l10n:Translate Key=Feature_VocalEnhance}" Margin="0,3"/>
              <CheckBox x:Name="CbHearingEnhance" Content="{l10n:Translate Key=Feature_HearingEnhance}" Margin="0,3"/>
            </StackPanel>
            <Button x:Name="BtnFindDevice" Content="{l10n:Translate Key=Feature_FindDevice}" Height="30" FontSize="13"
                    Click="BtnFindDevice_Click" Padding="18,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="SpatialAudioPanel" Visibility="Collapsed" Padding="16,14"
            CornerRadius="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="{l10n:Translate Key=SpatialAudio_Title}" FontSize="14"
                   HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" x:Name="SpatialAudioModes" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
