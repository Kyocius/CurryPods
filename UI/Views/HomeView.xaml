<UserControl
    x:Class="OppoPodsManager.UI.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization">

  <StackPanel Spacing="16" Margin="0,0,0,8">
    <Border Padding="16,14" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
      <StackPanel Spacing="6">
        <!-- 状态与设备切换行 -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" MinHeight="28" Margin="0,0,10,0">
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,8,0">
            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8" Fill="#FF5555" Margin="0,0,6,0"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Text="{l10n:Translate Key=Status_Disconnected}" FontSize="14" Foreground="#FF8888"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ComboBox x:Name="CbDevice" Grid.Column="1" Height="30" FontSize="11" MinWidth="96" MaxWidth="280"
                    HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed"
                    DisplayMemberPath="DisplayName"
                    ToolTipService.ToolTip="{l10n:Translate Key=Status_SwitchDeviceTooltip}"/>
          <Button x:Name="BtnRefreshDevices" Grid.Column="2" Content="&#x27F3;" Height="30" Width="30" FontSize="13"
                  Click="RefreshDevices_Click" Padding="0" Visibility="Collapsed" Margin="0,0,8,0"
                  ToolTipService.ToolTip="{l10n:Translate Key=Status_RefreshDevicesTooltip}"/>
          <Button x:Name="BtnReconnect" Grid.Column="3" Content="{l10n:Translate Key=Status_Reconnect}" Height="30" FontSize="13"
                  Click="Reconnect_Click" Padding="10,0" Visibility="Collapsed"/>
        </Grid>

        <!-- 电量槽位 -->
        <Grid x:Name="BatteryGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10" MinHeight="150">
          <StackPanel x:Name="LeftBatteryPanel" Grid.Column="0" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="LeftBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="LeftBatteryTitle" Text="{l10n:Translate Key=Battery_Left}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="LeftLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="LeftChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="LeftBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel x:Name="RightBatteryPanel" Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="RightBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="RightBatteryTitle" Text="{l10n:Translate Key=Battery_Right}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="RightLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="RightChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="RightBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>

          <StackPanel x:Name="CaseBatteryPanel" Grid.Column="2" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Image x:Name="CaseBatteryImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="CaseBatteryTitle" Text="{l10n:Translate Key=Battery_Case}" FontSize="12" Opacity="0.55"
                       HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
              <TextBlock x:Name="CaseLabel" Text="-%" FontSize="13" VerticalAlignment="Center"/>
              <Path x:Name="CaseChargeBolt" Width="10" Height="10" Stretch="Uniform"
                    Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                    Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
            </StackPanel>
            <ProgressBar x:Name="CaseBatteryProgress" Height="4" Minimum="0" Maximum="100"
                         HorizontalAlignment="Stretch" Margin="4,0" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="WearStatus" Text="" FontSize="12" HorizontalAlignment="Center"
                   Opacity="0.5" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <Expander x:Name="ConnectedDevicesExpander" Header="{l10n:Translate Key=Sidebar_MultiDevice}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="8">
        <ListView x:Name="DeviceList" x:FieldModifier="public" SelectionMode="None" MaxHeight="240"
                  HorizontalContentAlignment="Stretch"/>
        <TextBlock x:Name="DeviceListEmptyHint" x:FieldModifier="public" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Expander>

    <Border x:Name="AncPanel" Padding="20" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="16">
        <TextBlock Text="{l10n:Translate Key=Anc_Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <InfoBar x:Name="AncStatusInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                 Message="{l10n:Translate Key=Anc_Placeholder}"/>
        <RadioButtons x:Name="AncModes" MaxColumns="4" Visibility="Collapsed" SelectionChanged="AncModes_SelectionChanged"/>
        <ComboBox x:Name="AncLevels" Header="{l10n:Translate Key=Anc_Level}" MinWidth="200"
                  HorizontalAlignment="Left" Visibility="Collapsed" SelectionChanged="AncLevels_SelectionChanged"/>
        <TextBlock x:Name="AncRealtimeHint" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
    </Border>

    <Border x:Name="FeatureCard" Padding="20" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="12">
        <TextBlock Text="{l10n:Translate Key=Feature_Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <TextBlock x:Name="FeaturePlaceholderText" Text="{l10n:Translate Key=Feature_Placeholder}"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel x:Name="FeatureContentPanel" Spacing="8" Visibility="Collapsed">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbDualDevice}">
            <TextBlock Text="{l10n:Translate Key=Feature_DualDevice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbDualDevice" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_DualDevice}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbGame}">
            <TextBlock Text="{l10n:Translate Key=Feature_GameMode}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbGame" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_GameMode}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbLongPower}">
            <TextBlock Text="{l10n:Translate Key=Feature_LongPowerMode}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbLongPower" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_LongPowerMode}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbWearDetection}">
            <TextBlock Text="{l10n:Translate Key=Feature_WearDetection}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbWearDetection" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_WearDetection}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbSpineHealth}">
            <TextBlock Text="{l10n:Translate Key=Feature_SpineHealth}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbSpineHealth" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_SpineHealth}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbSpatial}">
            <TextBlock Text="{l10n:Translate Key=Feature_SpatialSound}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbSpatial" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_SpatialSound}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbGameSound}">
            <TextBlock Text="{l10n:Translate Key=Feature_GameSound}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbGameSound" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_GameSound}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbBassEngine}">
            <TextBlock Text="{l10n:Translate Key=Feature_BassEngine}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbBassEngine" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_BassEngine}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbVocalEnhance}">
            <TextBlock Text="{l10n:Translate Key=Feature_VocalEnhance}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbVocalEnhance" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_VocalEnhance}" VerticalAlignment="Center"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="48"
                Visibility="{Binding Visibility, ElementName=CbHearingEnhance}">
            <TextBlock Text="{l10n:Translate Key=Feature_HearingEnhance}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="CbHearingEnhance" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                          AutomationProperties.Name="{l10n:Translate Key=Feature_HearingEnhance}" VerticalAlignment="Center"/>
          </Grid>
          <Button x:Name="BtnFindDevice" Content="{l10n:Translate Key=Feature_FindDevice}"
                  Click="BtnFindDevice_Click" Visibility="Collapsed" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="SpatialAudioPanel" Visibility="Collapsed" Padding="20" CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel Spacing="12">
        <TextBlock Text="{l10n:Translate Key=SpatialAudio_Title}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel x:Name="SpatialAudioModes" Spacing="4"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>