<Window
    x:Class="OppoPodsManager.UI.MainWindow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OppoPodsManager.UI.Views"
    xmlns:controls="using:OppoPodsManager.UI.Controls"
    xmlns:loc="using:OppoPodsManager.Assets.Localization"
    Title="CurryPods">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootPanel">
        <Image x:Name="BgFullImage" Stretch="UniformToFill" Opacity="0.85" Visibility="Collapsed"/>
        <!-- 全高侧边栏背景板 -->
        <Border x:Name="SidebarFullBg" Width="200" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Background="{ThemeResource LayerFillColorDefaultBrush}"/>

        <Grid x:Name="RootGrid" ColumnDefinitions="200,*">
            <!-- ========== 侧边栏 ========== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" VerticalAlignment="Stretch"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 标题栏占位 / 拖动区域 -->
                    <Grid x:Name="CustomTitleBar" Grid.Row="0" Height="40" Background="Transparent" VerticalAlignment="Top"/>

                    <StackPanel Grid.Row="1" Margin="16,8,12,4" Spacing="4">
                        <TextBlock Text="{loc:Translate Key=Sidebar_MultiDevice}" FontSize="12" Opacity="0.55"
                                   Margin="14,0,0,2"/>
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ItemsControl x:Name="DeviceList" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="DeviceListEmptyHint" Text="{loc:Translate Key=Sidebar_NoDevices}"
                                           Visibility="Collapsed" Margin="12,8" FontSize="11" Opacity="0.45"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,10,12,0" Spacing="6" VerticalAlignment="Top">
                        <Button x:Name="NavHome" Content="{loc:Translate Key=Sidebar_NavHome}" Height="38" FontSize="13"
                                Click="NavHome_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8"/>
                        <Button x:Name="NavEq" Content="{loc:Translate Key=Sidebar_NavEq}" Height="38" FontSize="13"
                                Click="NavEq_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8"/>
                        <Button x:Name="NavPersonal" Content="{loc:Translate Key=Sidebar_NavPersonal}" Height="38" FontSize="13"
                                Click="NavPersonal_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8"/>
                    </StackPanel>

                    <Button Grid.Row="3" x:Name="NavSettings" Content="{loc:Translate Key=Sidebar_NavSettings}" Height="36" FontSize="13"
                            Click="NavSettings_Click" Margin="16,0,12,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="14,0" Background="Transparent" BorderThickness="0" CornerRadius="8"/>
                </Grid>
            </Border>

            <!-- ========== 右侧内容 ========== -->
            <Grid Grid.Column="1" Margin="0,32,0,0">
                <ScrollViewer x:Name="MainPanel" Padding="16,12,16,16" VerticalScrollBarVisibility="Hidden">
                    <views:HomeView x:Name="HomeView"/>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel" Padding="16,12,16,16"
                              VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <views:SettingsView x:Name="SettingsView"/>
                </ScrollViewer>

                <Grid x:Name="LogPanel" Visibility="Collapsed">
                    <views:LogView x:Name="LogView"/>
                </Grid>

                <ScrollViewer x:Name="AboutPanel" Padding="16,12,16,16"
                              VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <views:AboutView x:Name="AboutView"/>
                </ScrollViewer>

                <!-- ========== 个性化设置 ========== -->
                <ScrollViewer x:Name="EqPanel" Padding="16,12,16,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <views:EqView x:Name="EqView"/>
                </ScrollViewer>

                <ScrollViewer x:Name="PersonalPanel" Padding="16,12,16,16"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <views:PersonalView x:Name="PersonalView"/>
                </ScrollViewer>

                <ScrollViewer x:Name="DeviceInfoPanel" Padding="16,12,16,16"
                              VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                    <views:DeviceInfoView x:Name="DeviceInfoView"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========== 浮层对话框 ========== -->
        <Grid x:Name="DialogOverlay"
              Visibility="Collapsed" Background="#80000000" Canvas.ZIndex="100"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border x:Name="DialogBox" CornerRadius="12" Padding="20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="320" MaxWidth="560" MaxHeight="460">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
                    <TextBlock x:Name="DialogTitle" Text="{loc:Translate Key=Dialog_SaveEqPreset}"
                               FontSize="16" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="DialogMessage" Text="{loc:Translate Key=Dialog_InputPresetName}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <TextBox Grid.Row="2" x:Name="DialogInput" PlaceholderText="{loc:Translate Key=Dialog_PresetNamePlaceholder}"
                             Width="260" Height="34" FontSize="13" Padding="8,4"/>
                    <controls:WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancelBtn" Content="{loc:Translate Key=Dialog_Cancel}"
                                Height="32" FontSize="13" Padding="14,0" Margin="0,0,8,8"
                                Click="DialogCancel_Click"/>
                        <Button x:Name="DialogSkipBtn" Content="{loc:Translate Key=Dialog_SkipVersion}"
                                Height="32" FontSize="13" Padding="14,0" Margin="0,0,8,8"
                                Visibility="Collapsed" Click="DialogSkip_Click"/>
                        <Button x:Name="DialogConfirmBtn" Content="{loc:Translate Key=Dialog_Save}"
                                Height="32" FontSize="13" Padding="14,0" Margin="0,0,8,8"
                                Click="DialogConfirm_Click"/>
                    </controls:WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
