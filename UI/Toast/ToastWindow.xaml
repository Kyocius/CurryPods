<Window
    x:Class="OppoPodsManager.UI.Toast.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization"
    Title="CurryPods Toast">
    <Border x:Name="RootLayout" Width="360" Padding="20"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <FontIcon Glyph="&#xE7F6;" FontSize="20" VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="TitleBlock" Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusText" Text="{l10n:Translate Key=Toast_Connected}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <InfoBar x:Name="BatteryWarning" IsOpen="False" IsClosable="False"/>
            <Grid x:Name="BatteryPanel" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Padding="8,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="LeftPct" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="LeftBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                            <TextBlock Text="{l10n:Translate Key=Toast_LeftLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="8,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="CasePct" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="CaseBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                            <TextBlock Text="{l10n:Translate Key=Toast_CaseLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="8,12" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="RightPct" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="RightBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                            <TextBlock Text="{l10n:Translate Key=Toast_RightLabel}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</Window>
