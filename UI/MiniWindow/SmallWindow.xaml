<Window x:Class="OppoPodsManager.UI.MiniWindow.Status.SmallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization" Title="CurryPods">
    <Grid x:Name="RootGrid" Width="360" MaxHeight="560" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <ScrollViewer x:Name="QuickControlsScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" Padding="20" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DeviceTitle" Text="CurryPods" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ConnectionStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                    <Button x:Name="BtnClose" Grid.Column="1" Width="32" Height="32" Padding="0" Click="CustomClose_Click"
                            AutomationProperties.Name="{l10n:Translate Key=Common_Close}" Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">                    <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                        <Image x:Name="LeftImage" Height="36" Width="48" Stretch="Uniform"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="LeftLabel" Text="–%" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <FontIcon x:Name="LeftChargeBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="{l10n:Translate Key=Toast_LeftLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
                        <Image x:Name="CaseImage" Height="36" Width="48" Stretch="Uniform"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="CaseLabel" Text="–%" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <FontIcon x:Name="CaseChargeBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="{l10n:Translate Key=Toast_CaseLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                        <Image x:Name="RightImage" Height="36" Width="48" Stretch="Uniform"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="RightLabel" Text="–%" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <FontIcon x:Name="RightChargeBolt" Glyph="&#xE945;" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="{l10n:Translate Key=Toast_RightLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Grid x:Name="AncCard" ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="Collapsed">
                    <TextBlock Text="{l10n:Translate Key=Anc_Title}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="NoiseModes" Grid.Column="1" MaxWidth="190" MinWidth="120"
                              AutomationProperties.Name="{l10n:Translate Key=Anc_Title}" SelectionChanged="NoiseModes_SelectionChanged"/>
                </Grid>
                <StackPanel x:Name="FeatureCard" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="FeaturePlaceholderText" Text="{l10n:Translate Key=Feature_Unsupported}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="FeatureContentPanel" Spacing="4" Visibility="Collapsed">                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbDualDevice}">
                            <TextBlock Text="{l10n:Translate Key=Feature_DualDevice}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbDualDevice" Grid.Column="1" Tag="dual-device" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_DualDevice}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbGame}">
                            <TextBlock Text="{l10n:Translate Key=Feature_GameMode}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbGame" Grid.Column="1" Tag="game-mode" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_GameMode}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbLongPower}">
                            <TextBlock Text="{l10n:Translate Key=Feature_LongPowerMode}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbLongPower" Grid.Column="1" Tag="long-battery" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_LongPowerMode}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbWearDetection}">
                            <TextBlock Text="{l10n:Translate Key=Feature_WearDetection}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbWearDetection" Grid.Column="1" Tag="wear-detection" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_WearDetection}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbSpineHealth}">
                            <TextBlock Text="{l10n:Translate Key=Feature_SpineHealth}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbSpineHealth" Grid.Column="1" Tag="spine-health" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_SpineHealth}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbSpatial}">
                            <TextBlock Text="{l10n:Translate Key=Feature_SpatialSound}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbSpatial" Grid.Column="1" Tag="spatial-sound" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_SpatialSound}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbGameSound}">
                            <TextBlock Text="{l10n:Translate Key=Feature_GameSound}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbGameSound" Grid.Column="1" Tag="game-sound" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_GameSound}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbBassEngine}">
                            <TextBlock Text="{l10n:Translate Key=Feature_BassEngine}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbBassEngine" Grid.Column="1" Tag="bass-engine" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_BassEngine}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbVocalEnhance}">
                            <TextBlock Text="{l10n:Translate Key=Feature_VocalEnhance}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbVocalEnhance" Grid.Column="1" Tag="voice-enhancement" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_VocalEnhance}" VerticalAlignment="Center"/>
                        </Grid>                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" MinHeight="44" Visibility="{Binding Visibility, ElementName=CbHearingEnhance}">
                            <TextBlock Text="{l10n:Translate Key=Feature_HearingEnhance}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="CbHearingEnhance" Grid.Column="1" Tag="hearing-enhancement" MinWidth="0" OnContent="" OffContent=""
                                          AutomationProperties.Name="{l10n:Translate Key=Feature_HearingEnhance}" VerticalAlignment="Center"/>
                        </Grid>                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>