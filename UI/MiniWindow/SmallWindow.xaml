<Window
    x:Class="OppoPodsManager.UI.MiniWindow.Status.SmallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:OppoPodsManager.Assets.Localization"
    Title="CurryPods">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Width="300" MaxHeight="440">
        <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed" Opacity="0.82"/>
        <Border x:Name="BgTint" Visibility="Collapsed" Background="#66000000"/>

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="ContentStack" Margin="14,10,14,14" Spacing="12">
                <!-- 关闭按钮 -->
                <Button x:Name="BtnClose" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Padding="0" Margin="0" Background="Transparent" BorderThickness="0"
                        Click="CustomClose_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>

                <!-- 电量 -->
                <Border x:Name="BatteryCard" Padding="16,14" CornerRadius="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,*,*" Width="240" ColumnSpacing="12" HorizontalAlignment="Center">
                            <Image x:Name="LeftImage" Grid.Column="0" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CaseImage" Grid.Column="1" Height="50" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="RightImage" Grid.Column="2" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" Width="240" ColumnSpacing="12" HorizontalAlignment="Center">
                            <!-- 左耳 -->
                            <StackPanel Grid.Column="0" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="LeftLabel" Text="–%" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path x:Name="LeftChargeBolt" Width="12" Height="12" Stretch="Uniform" Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                                          Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
                                </StackPanel>
                                <TextBlock Text="{l10n:Translate Key=Toast_LeftLabel}" FontSize="12" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 耳机仓 -->
                            <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CaseLabel" Text="–%" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path x:Name="CaseChargeBolt" Width="12" Height="12" Stretch="Uniform" Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                                          Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
                                </StackPanel>
                                <TextBlock Text="{l10n:Translate Key=Toast_CaseLabel}" FontSize="12" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 右耳 -->
                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="RightLabel" Text="–%" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Path x:Name="RightChargeBolt" Width="12" Height="12" Stretch="Uniform" Fill="#4CD964" VerticalAlignment="Center" Visibility="Collapsed"
                                          Data="M0.009,7.21C-0.023,7.286 0.032,7.37 0.115,7.37H3.303V11.885C3.303,12.011 3.476,12.045 3.524,11.929L6.6,4.471C6.631,4.396 6.575,4.313 6.494,4.313H3.303V0.115C3.303,-0.01 3.132,-0.045 3.083,0.069L0.009,7.21Z"/>
                                </StackPanel>
                                <TextBlock Text="{l10n:Translate Key=Toast_RightLabel}" FontSize="12" Opacity="0.55" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ANC -->
                <Border x:Name="AncCard" Padding="16,14" CornerRadius="14" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{l10n:Translate Key=Anc_Title}" FontSize="14" HorizontalAlignment="Center"/>
                        <Grid x:Name="AncMainRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
                        <Grid x:Name="AncSubRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AncRealtimeHint" FontSize="13" Opacity="0.5" Visibility="Collapsed" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 功能开关 -->
                <Border x:Name="FeatureCard" Padding="14,14" CornerRadius="14" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l10n:Translate Key=Feature_Title}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FeaturePlaceholderText" Text="{l10n:Translate Key=Feature_Placeholder}" FontSize="13" Opacity="0.45" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="FeatureContentPanel" Visibility="Collapsed" Spacing="4">
                            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                <CheckBox x:Name="CbDualDevice" Tag="dual-device" Content="{l10n:Translate Key=Feature_DualDevice}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbGame" Tag="game-mode" Content="{l10n:Translate Key=Feature_GameMode}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbLongPower" Tag="long-battery" Content="{l10n:Translate Key=Feature_LongPowerMode}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbWearDetection" Tag="wear-detection" Content="{l10n:Translate Key=Feature_WearDetection}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbSpineHealth" Tag="spine-health" Content="{l10n:Translate Key=Feature_SpineHealth}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbSpatial" Tag="spatial-sound" Content="{l10n:Translate Key=Feature_SpatialSound}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbGameSound" Tag="game-sound" Content="{l10n:Translate Key=Feature_GameSound}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbBassEngine" Tag="bass-engine" Content="{l10n:Translate Key=Feature_BassEngine}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbVocalEnhance" Tag="voice-enhancement" Content="{l10n:Translate Key=Feature_VocalEnhance}" Margin="2,2" FontSize="12"/>
                                <CheckBox x:Name="CbHearingEnhance" Tag="hearing-enhancement" Content="{l10n:Translate Key=Feature_HearingEnhance}" Margin="2,2" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
