<Application
    x:Class="OppoPodsManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OppoPodsManager">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#6090FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
